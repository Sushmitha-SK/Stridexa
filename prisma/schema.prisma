generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Clerk Organizations = workspaces. Clerk handles members and roles;
// we only store the Clerk IDs as strings.

model Workspace {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique // org_... OR user_... (personal workspace)
  name       String
  slug       String   @unique
  createdAt  DateTime @default(now())

  projects   Project[]
  activities Activity[]
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_ASSIGNED
  TASK_DELETED
  COMMENT_ADDED
  PROJECT_CREATED
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  key         String // short prefix for task numbers, e.g. "WEB" -> WEB-12
  description String?
  archivedAt  DateTime?
  taskCounter Int       @default(0) // increment in a transaction to get the next task number
  createdById String // Clerk user id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([workspaceId, key])
  @@index([workspaceId, archivedAt])
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String?
  taskId      String? // becomes a real relation in the next branch
  actorId     String // Clerk user id
  type        ActivityType
  // e.g. { key: "WEB-3", title: "...", from: "TODO", to: "DONE" }
  metadata    Json?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
}